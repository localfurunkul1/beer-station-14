uniform sampler2D SCREEN_TEXTURE;
uniform highp float Intensity;

void fragment() {
    highp vec4 col = zTextureSpec(SCREEN_TEXTURE, UV);
    highp vec2 centered = UV - vec2(0.5, 0.5);
    highp float r2 = dot(centered, centered);

    highp float pulse = 0.5 + 0.5 * sin(TIME * 5.5);
    highp float vig = clamp(r2 * 4.5, 0.0, 1.0);
    highp float strength = Intensity * (0.45 + 0.55 * pulse) * vig;

    highp vec3 redTint = vec3(0.6, 0.04, 0.06);
    highp vec3 mixed = mix(col.rgb, redTint, strength * 0.65);
    mixed *= mix(1.0, 0.78, strength * 0.5);

    COLOR = vec4(mixed, col.a);
}
